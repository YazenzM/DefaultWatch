# Freddie Mac terms restrict redistribution: raw files, anything derived at loan level,
# and models fit to them stay local. Only code and aggregate results are published.
data/raw/*
data/processed/*
!data/raw/README.md
!data/**/.gitkeep
models/*
!models/.gitkeep

